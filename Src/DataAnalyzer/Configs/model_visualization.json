  "task_descriptions": {
    "confusion_matrix": "分类模型的预测 vs 真实标签对比。",
    "roc_curve": "受试者工作特征曲线，评估分类性能。",
    "precision_recall_curve": "精确率-召回率曲线，适用于不平衡数据。",
    "calibration_curve": "模型预测概率的校准程度。",
    "shap_summary_plot": "SHAP 值特征重要性及影响方向。",
    "shap_force_plot": "单样本预测的 SHAP 解释。",
    "partial_dependence_plot": "特征对预测的边际影响。",
    "silhouette_analysis": "评估聚类质量，辅助选择 k 值。",
    "elbow_method_plot": "KMeans 肘部图，选择最优聚类数。",
    "t_sne_projection": "高维数据降维可视化。",
    "umap_projection": "UMAP 降维可视化，保留全局结构。",
    "biplot": "PCA 中样本与特征的联合可视化。",
    "dendrogram": "层次聚类的树状图。",
    "missing_value_matrix": "缺失值分布热图。",
    "word_cloud": "文本关键词频率可视化。",
    "waterfall_chart": "展示预测值的特征贡献分解。"
  },
  "task_aliases": {
    "cm": "confusion_matrix",
    "roc": "roc_curve",
    "pr": "precision_recall_curve",
    "calib": "calibration_curve",
    "feat_imp": "feature_importance",
    "shap": "shap_summary_plot",
    "pdp": "partial_dependence_plot",
    "silhouette": "silhouette_analysis",
    "elbow": "elbow_method_plot",
    "tsne": "t_sne_projection",
    "umap": "umap_projection",
    "biplot": "biplot",
    "dendro": "dendrogram"
  },
  "plot_backend": {
    "default": "matplotlib",
    "overrides": {
      "scatter_3d": "plotly",
      "surface_3d": "plotly",
      "wireframe_3d": "plotly",
      "gauge_chart": "plotly",
      "waterfall_chart": "plotly",
      "interactive_scatter": "plotly",
      "network_graph": "bokeh",
      "calendar_heatmap": "seaborn"
    }
  },
  "interactive_plots": [
    "scatter",
    "scatter_3d",
    "surface_3d",
    "pair_plot",
    "t_sne_projection",
    "umap_projection",
    "shap_summary_plot",
    "shap_force_plot",
    "waterfall_chart",
    "network_graph",
    "gauge_chart",
    "interactive_scatter"
  ],
  "max_data_size": {
    "t_sne_projection": 10000,
    "umap_projection": 50000,
    "pair_plot": 5000,
    "network_graph": 2000,
    "decision_boundary": 1000,
    "perplexity_comparison": 5000,
    "embedding_scatter": 100000
  },
  "max_features": {
    "pair_plot": 10,
    "correlation_circle": 20,
    "biplot": 20,
    "parallel_coordinates": 15
  },
  "required_dimensions": {
    "scatter_3d": 3,
    "surface_3d": 2,
    "projection_3d": 3,
    "wireframe_3d": 3
  },
  "plot_defaults": {
    "scatter": {
      "size": 50,
      "alpha": 0.7,
      "color_scheme": "viridis"
    },
    "line": {
      "linewidth": 2,
      "marker": "o",
      "markersize": 4
    },
    "bar": {
      "color": "#1f77b4",
      "edgecolor": "black"
    },
    "heatmap": {
      "cmap": "RdBu_r",
      "annot": true,
      "fmt": ".2f"
    },
    "shap_summary_plot": {
      "plot_type": "dot",
      "color": "shap",
      "max_display": 10
    },
    "tree_visualization": {
      "rounded": true,
      "filled": true,
      "fontsize": 10
    },
    "violin_plot": {
      "scale": "width",
      "inner": "quartile"
    }
  },
  "dependencies": {
    "shap_summary_plot": "shap",
    "shap_force_plot": "shap",
    "t_sne_projection": "sklearn",
    "umap_projection": "umap-learn",
    "embedding_scatter": "umap-learn",
    "connectivity_plot": "umap-learn",
    "word_cloud": "wordcloud",
    "network_graph": "networkx, pyvis",
    "gauge_chart": "plotly",
    "waterfall_chart": "plotly",
    "interactive_scatter": "plotly",
    "scatter_3d": "plotly",
    "surface_3d": "plotly",
    "wireframe_3d": "plotly"
  },
  "export_formats": {
    "vector": ["svg", "pdf"],
    "raster": ["png", "jpg"],
    "interactive": ["html", "json"],
    "default": "png"
  },
  "usage_scope": {
    "cooks_distance_plot": "diagnostic",
    "leverage_plot": "diagnostic",
    "perplexity_comparison": "tuning",
    "gauge_chart": "dashboard",
    "waterfall_chart": "explanation",
    "shap_force_plot": "explanation",
    "calibration_curve": "validation"
  }
